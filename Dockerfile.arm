# Dockerfile for building Kindle HID Passthrough ARM binary
# Uses PyInstaller which may handle glibc dependencies better than Nuitka
# Target: ARMv7 hard-float (armhf)

FROM arm32v7/python:3.10-slim-bullseye

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        binutils \
        zlib1g-dev \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    pyinstaller \
    staticx \
    bumble>=0.0.193 \
    aiofiles>=23.0.0

# Set working directory
WORKDIR /build

# Copy source files
COPY kindle_hid_passthrough/*.py /build/kindle_hid_passthrough/
COPY kindle_hid_passthrough/config.ini /build/kindle_hid_passthrough/

# Build with PyInstaller
# --onefile creates a single executable
# --hidden-import ensures bumble modules are included
RUN python3 -m PyInstaller \
    --onefile \
    --name kindle-hid-passthrough-base \
    --add-data "kindle_hid_passthrough/config.ini:kindle_hid_passthrough" \
    --hidden-import bumble \
    --hidden-import bumble.hci \
    --hidden-import bumble.host \
    --hidden-import bumble.transport \
    --hidden-import aiofiles \
    kindle_hid_passthrough/main.py

# Wrap with staticx for static linking (may help with glibc compatibility)
RUN staticx dist/kindle-hid-passthrough-base dist/kindle-hid-passthrough

# Output will be at /build/dist/kindle-hid-passthrough
