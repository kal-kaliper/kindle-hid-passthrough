# Cross-compilation Dockerfile for Kindle HID Passthrough ARM binary
# Uses x86_64 host with ARM cross-compilation toolchain
# Target: ARMv7 hard-float (armhf)
# Estimated build time: 1-1.5 hours (vs 6+ hours with QEMU)

FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install cross-compilation toolchain and build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc-arm-linux-gnueabihf \
        g++-arm-linux-gnueabihf \
        binutils-arm-linux-gnueabihf \
        wget \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
        python3-dev \
        pkg-config \
        ccache \
        patchelf \
        file \
    && rm -rf /var/lib/apt/lists/*

# Download pre-built ARM Python from python-build-standalone
# This avoids the long Python compilation step
ENV PYTHON_VERSION=3.10.14
ENV PYTHON_RELEASE=20240726
RUN cd /opt && \
    wget https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-armv7-unknown-linux-gnueabihf-install_only.tar.gz && \
    tar xzf cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-armv7-unknown-linux-gnueabihf-install_only.tar.gz && \
    rm cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-armv7-unknown-linux-gnueabihf-install_only.tar.gz

# Set paths for ARM Python
ENV ARM_PYTHON=/opt/python
ENV ARM_PYTHON_BIN=${ARM_PYTHON}/bin/python3

# Install Nuitka, build tools, and runtime dependencies on host Python
# Nuitka will compile these and bundle them into the binary
RUN pip3 install --no-cache-dir \
    nuitka \
    ordered-set \
    zstandard \
    bumble>=0.0.193 \
    aiofiles>=23.0.0

# Set up cross-compilation environment for C compiler
ENV CC=arm-linux-gnueabihf-gcc
ENV CXX=arm-linux-gnueabihf-g++
ENV AR=arm-linux-gnueabihf-ar
ENV RANLIB=arm-linux-gnueabihf-ranlib

# Enable ccache
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:${PATH}"

WORKDIR /build

# Copy source files
COPY kindle_hid_passthrough/*.py /build/kindle_hid_passthrough/
COPY kindle_hid_passthrough/config.ini /build/kindle_hid_passthrough/

# Build with Nuitka
# Host Python runs Nuitka, which cross-compiles for ARM Python runtime
RUN python3 -m nuitka \
    --mode=onefile \
    --onefile-tempdir-spec=/mnt/us/tmp \
    --jobs=$(nproc) \
    --lto=no \
    --show-progress \
    --output-filename=kindle-hid-passthrough \
    --python-for-scons=${ARM_PYTHON_BIN} \
    --include-package=kindle_hid_passthrough \
    --include-package=bumble \
    --nofollow-import-to=bumble \
    --include-data-file=kindle_hid_passthrough/config.ini=kindle_hid_passthrough/config.ini \
    --nofollow-import-to=pytest \
    --nofollow-import-to=unittest \
    --nofollow-import-to=setuptools \
    kindle_hid_passthrough/main.py

# Output: /build/kindle-hid-passthrough
